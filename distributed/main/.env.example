# ============================================================
# 模板示例：复制为同目录下的 .env 并填写真实值
# 本文件（.env.example）不含任何敏感信息，可安全提交
# ============================================================
# hoj全部数据存储的文件夹位置（默认当前路径生成hoj文件夹）
HOJ_DATA_DIRECTORY=./hoj

# redis的配置
REDIS_HOST=your-host-ip-or-domain
REDIS_PORT=6379
REDIS_PASSWORD=your_password_here

# mysql的配置
MYSQL_HOST=your-host-ip-or-domain
# 请提供当前mysql所在服务器的公网ip
MYSQL_PUBLIC_HOST=your-host-ip-or-domain
MYSQL_PUBLIC_PORT=3306
MYSQL_ROOT_PASSWORD=your_password_here

# nacos的配置
NACOS_HOST=your-host-ip-or-domain
NACOS_PORT=8848
NACOS_USERNAME=your_username
NACOS_PASSWORD=your_password_here

# backend后端服务的配置
BACKEND_HOST=your-host-ip-or-domain
BACKEND_PORT=6688
# token加密秘钥 默认则生成32位随机密钥
JWT_TOKEN_SECRET=change_me_random_string
# token过期时间默认为24小时 86400s
JWT_TOKEN_EXPIRE=your_password_here
# token默认12小时可自动刷新
JWT_TOKEN_FRESH_EXPIRE=your_password_here
# 调用判题服务器的token 默认则生成32位随机密钥
JUDGE_TOKEN=change_me_random_string
# 请使用邮件服务的域名或ip
EMAIL_SERVER_HOST=your-host-ip-or-domain
EMAIL_SERVER_PORT=465
EMAIL_USERNAME=your_username
EMAIL_PASSWORD=your_password_here
# 开启虚拟判题请提供对应oj的账号密码 格式为 
# username1,username2,...
# password1,password2,...
HDU_ACCOUNT_USERNAME_LIST=
HDU_ACCOUNT_PASSWORD_LIST=your_password_here
CF_ACCOUNT_USERNAME_LIST=
CF_ACCOUNT_PASSWORD_LIST=your_password_here
POJ_ACCOUNT_USERNAME_LIST=
POJ_ACCOUNT_PASSWORD_LIST=your_password_here
ATCODER_ACCOUNT_USERNAME_LIST=
ATCODER_ACCOUNT_PASSWORD_LIST=your_password_here
SPOJ_ACCOUNT_USERNAME_LIST=
SPOJ_ACCOUNT_PASSWORD_LIST=your_password_here
LIBRE_ACCOUNT_USERNAME_LIST=
LIBRE_ACCOUNT_PASSWORD_LIST=your_password_here
# 是否强制使用上面配置的账号覆盖系统原有的账号列表
FORCED_UPDATE_REMOTE_JUDGE_ACCOUNT=false

# 评测数据同步的配置
# 请修改数据同步密码
RSYNC_PASSWORD=your_password_here

# docker network的配置
SUBNET=172.20.0.0/16
